{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provin.dev/schemas/agent-access-deployment.json",
  "title": "Declared Agent-readable paths",
  "type": "object",
  "additionalProperties": false,
  "required": ["deploymentId", "appraisalBoundaryId", "paths"],
  "properties": {
    "deploymentId": { "$ref": "#/$defs/versionedId" },
    "appraisalBoundaryId": { "$ref": "#/$defs/versionedId" },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "state": { "enum": ["ENABLED", "DISABLED"] },
          "boundaryId": { "$ref": "#/$defs/versionedId" }
        },
        "allOf": [
          {
            "if": { "properties": { "state": { "const": "ENABLED" } } },
            "then": { "required": ["boundaryId"] },
            "else": { "not": { "required": ["boundaryId"] } }
          }
        ]
      }
    }
  },
  "$defs": {
    "versionedId": {
      "type": "string",
      "pattern": "^.+@[0-9]+$"
    }
  }
}
