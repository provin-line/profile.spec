{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dplaax rule catalog shard",
  "description": "Shape of rules/*.yaml. Content discipline (statement length, RFC 2119 keyword placement, reference resolution) is enforced by tools/lint.py; this schema covers structure only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "class", "statement", "uses", "schemas", "vectors", "notes"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){1,3}$"
        },
        "status": { "enum": ["todo", "draft", "stable"] },
        "class": { "enum": ["core", "audit-reachable"] },
        "statement": { "type": ["string", "null"] },
        "uses": { "type": "array", "items": { "type": "string" } },
        "schemas": { "type": "array", "items": { "type": "string" } },
        "vectors": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "source": { "type": "string" }
      }
    }
  }
}
